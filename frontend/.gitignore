# Dependencies
node_modules

# Build and type-check output
dist
dist-ssr
*.tsbuildinfo

# Test output
coverage

# Tool caches
.eslintcache
.oxlintcache
.vite/

# Environment files — only committed examples are shared
.env
.env.*
!.env.example
!.env.*.example

# Machine-specific overrides (config.local.json, *.local)
*.local

# Runtime chat traces (user-collected sessions — never committed;
# traces/README.md and its instructions stay tracked)
traces/**/*.jsonl

# Deliberately tracked despite being generated:
#   public/llms/            — regenerated by `npm run generate:llms` (predev/prebuild)
#   src/data/evalResults.ts — regenerated by `npm run eval:chain`

